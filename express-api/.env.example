# Mindwell Express API — copy to `.env` and adjust. NEVER commit the real `.env`.

APP_NAME=Mindwell Express API
PORT=3000
NODE_ENV=development

# Public URLs
BACKEND_URL=http://localhost:3000
LARAVEL_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed to call the API (comma-separated).
# In development localhost:8080 is allowed automatically for the built preview.
FRONTEND_URLS=http://localhost:8080

# HS256 secret shared with the Laravel service (same value in laravel-api/.env).
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_generate_a_long_random_secret
# Access token lifetime (short) and refresh token lifetime.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Random secret used to sign the double-submit CSRF token cookie.
# Generate a SEPARATE random string, different from JWT_SECRET.
CSRF_SECRET=change_me_generate_another_long_random_secret

# Shared key for service-to-service (Express <-> Laravel) internal endpoints.
# Generate a SEPARATE random string, different from the two secrets above.
SERVICE_KEY=change_me_generate_a_third_long_random_secret

# MariaDB / MySQL (XAMPP default: root with an empty password on localhost:3306)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=mindwell
DATABASE_PASSWORD=mindwell_dev_pw
DATABASE_NAME=mindwell_db

# IANA timezone used for stored appointment datetimes (UTC) and display guidance.
APP_TIMEZONE=UTC
