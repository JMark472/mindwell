# Mindwell Laravel API — copy to `.env` and adjust. NEVER commit the real `.env`.

APP_NAME="Mindwell Laravel API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MariaDB / MySQL (same database as the Express service)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mindwell_db
DB_USERNAME=mindwell
DB_PASSWORD=mindwell_dev_pw

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mindwell.test"
MAIL_FROM_NAME="${APP_NAME}"

# Origins allowed to call this API with credentials (the React SPA).
# FRONTEND_URLS accepts a comma-separated list of extra origins.
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:8080

# HS256 secret shared with the Express service. Must match express-api/.env.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_generate_a_long_random_secret

# Shared key for service-to-service calls. Must match express-api/.env.
SERVICE_KEY=change_me_generate_a_third_long_random_secret
