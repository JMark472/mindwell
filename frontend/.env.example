# Mindwell frontend — copy to `.env` for local development.
# In production (Vercel/hosting) set the same variables in the project dashboard.
# Vite bakes VITE_* values at build time; rebuild/restart after changes.

# --- Local development (Vite dev server, separate API origins) ---
# Express service: auth, users, notifications, admin, reports
VITE_EXPRESS_API_URL=http://localhost:3000

# Laravel service: appointments, counselors, wellness, records
VITE_LARAVEL_API_URL=http://localhost:8000

# --- Single-origin preview/tunnel mode (Vite preview proxy) ---
# For `vite preview` or a shared tunnel (e.g. Cloudflare) where the frontend
# and APIs must be served from one origin, use the proxied paths instead:
# VITE_EXPRESS_API_URL=/express
# VITE_LARAVEL_API_URL=/laravel
# The preview server proxies /express -> Express (:3000) and /laravel -> Laravel (:8000).
# If you also call the APIs directly from another origin, add that origin to
# FRONTEND_URLS in express-api/.env and laravel-api/.env.
